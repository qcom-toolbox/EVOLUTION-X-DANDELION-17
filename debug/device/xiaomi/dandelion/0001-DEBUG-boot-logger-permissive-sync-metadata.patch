diff --git a/rootdir/etc/bootlog.rc b/rootdir/etc/bootlog.rc
new file mode 100644
index 0000000..b0e13c2
--- /dev/null
+++ b/rootdir/etc/bootlog.rc
@@ -0,0 +1,47 @@
+# Local debug: persist kernel log and logcat across reboots in /metadata/bootlog
+on early-init
+    mkdir /metadata/bootlog 0770 root system
+    start bootlog_kmsg
+
+on property:init.svc.logd=running
+    start bootlog_logcat
+
+service bootlog_kmsg /system/bin/sh -c "mv -f /metadata/bootlog/kmsg.txt /metadata/bootlog/kmsg.prev.txt; f=/metadata/bootlog/kmsg.txt; while true; do if [ $$(stat -c %s $$f 2>/dev/null || echo 0) -gt 3000000 ]; then mv -f $$f /metadata/bootlog/kmsg.old.txt; fi; cat /dev/kmsg >> $$f; done"
+    user root
+    group root
+    oneshot
+    disabled
+    seclabel u:r:su:s0
+
+service bootlog_logcat /system/bin/sh -c "mv -f /metadata/bootlog/logcat.txt /metadata/bootlog/logcat.prev.txt; exec /system/bin/logcat -b all -v threadtime > /metadata/bootlog/logcat.txt"
+    user root
+    group root
+    oneshot
+    disabled
+    seclabel u:r:su:s0
+
+service bootlog_sync /system/bin/sh -c "while true; do sync; sleep 1; done"
+    user root
+    group root
+    oneshot
+    disabled
+    seclabel u:r:su:s0
+
+on early-init
+    start bootlog_sync
+
+on post-fs-data
+    mkdir /data/bootlog 0770 root system
+    start bootlog_logcat_data
+
+service bootlog_logcat_data /system/bin/sh -c "mv -f /data/bootlog/logcat.txt /data/bootlog/logcat.prev.txt; exec /system/bin/logcat -b all -v threadtime > /data/bootlog/logcat.txt"
+    user root
+    group root
+    oneshot
+    disabled
+    seclabel u:r:su:s0
+
+# Local debug: stock A10 vendor usb rc restores sys.usb.config from
+# ${sys.usb.state}, which A17 hasn't set yet -> adb ends up "none".
+on post-fs
+    setprop sys.usb.state adb
