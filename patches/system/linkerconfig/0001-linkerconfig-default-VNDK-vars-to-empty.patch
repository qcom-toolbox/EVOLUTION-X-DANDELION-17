linkerconfig: default VNDK/sanitizer variables to empty

Variables::GetValue() treats empty as undefined, and Var() without a default
aborts. With a VNDK vendor, the bootstrap run happens before the (non-bootstrap)
VNDK APEX is mounted, and SANITIZER_DEFAULT_* is empty whenever the build has no
sanitizer.libraries.txt, so linkerconfig aborted and nothing on /vendor could
link. MergeLibs() already skips empty entries.

 contents/namespace/productdefault.cc | 10 +++++-----
 contents/namespace/vendordefault.cc  |  8 ++++----
 contents/namespace/vndk.cc           |  2 +-
 contents/namespace/vndkinsystem.cc   |  2 +-
 contents/section/apexdefault.cc      |  6 +++---
 contents/section/sectionbuilder.cc   |  6 +++---
 6 files changed, 17 insertions(+), 17 deletions(-)

diff --git a/contents/namespace/productdefault.cc b/contents/namespace/productdefault.cc
index 52f9fed..87d2f1c 100644
--- a/contents/namespace/productdefault.cc
+++ b/contents/namespace/productdefault.cc
@@ -41,17 +41,17 @@ Namespace BuildProductNamespace(const Context& ctx, const std::string& name) {
   AddLlndkLibraries(ctx, &ns, VndkUserPartition::Product);
   if (android::linkerconfig::modules::IsProductVndkVersionDefined()) {
     ns.GetLink(ctx.GetSystemNamespaceName())
-        .AddSharedLib(Var("SANITIZER_DEFAULT_PRODUCT"));
+        .AddSharedLib(Var("SANITIZER_DEFAULT_PRODUCT", ""));
     if (ctx.IsSystemSection() || ctx.IsUnrestrictedSection()) {
       ns.GetLink("vndk_product")
-          .AddSharedLib(Var("VNDK_SAMEPROCESS_LIBRARIES_PRODUCT"));
+          .AddSharedLib(Var("VNDK_SAMEPROCESS_LIBRARIES_PRODUCT", ""));
     } else {
       ns.GetLink("vndk").AddSharedLib(
-          {Var("VNDK_SAMEPROCESS_LIBRARIES_PRODUCT"),
-           Var("VNDK_CORE_LIBRARIES_PRODUCT")});
+          {Var("VNDK_SAMEPROCESS_LIBRARIES_PRODUCT", ""),
+           Var("VNDK_CORE_LIBRARIES_PRODUCT", "")});
       if (android::linkerconfig::modules::IsVndkInSystemNamespace()) {
         ns.GetLink("vndk_in_system")
-            .AddSharedLib(Var("VNDK_USING_CORE_VARIANT_LIBRARIES"));
+            .AddSharedLib(Var("VNDK_USING_CORE_VARIANT_LIBRARIES", ""));
       }
     }
   }
