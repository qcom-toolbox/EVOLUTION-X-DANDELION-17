Bluetooth: don't abort when a controller rejects READ_DEFAULT_ERRONEOUS_DATA_REPORTING

Legacy MediaTek combo chips (MT6762/MT6765) advertise the command but answer it with a
failing Command Status. The HCI layer asserted 'was not expecting status event' and the
Bluetooth stack crash-looped (restarting the shared Wi-Fi/BT chip each time). Its
handler already treats an invalid Command Complete as unsupported (b/277589118), so
convert the status the same way vendor-specific commands are handled.

 system/gd/hci/hci_layer.cc | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/system/gd/hci/hci_layer.cc b/system/gd/hci/hci_layer.cc
index fd85769..6ec2ab2 100644
--- a/system/gd/hci/hci_layer.cc
+++ b/system/gd/hci/hci_layer.cc
@@ -260,8 +260,16 @@ struct HciLayer::impl {
     using WaitingFor = CommandQueueEntry::WaitingFor;
     WaitingFor waiting_for = command_queue_.front().waiting_for_;
     CommandStatusView status_view = CommandStatusView::Create(event);
-    if (is_vendor_specific && (is_status && waiting_for == WaitingFor::COMPLETE) &&
-        (status_view.IsValid() && status_view.GetStatus() == ErrorCode::UNKNOWN_HCI_COMMAND)) {
+    // Local: some legacy controllers (e.g. MT6765/MT6762 combo chips) advertise
+    // READ_DEFAULT_ERRONEOUS_DATA_REPORTING but answer it with a failing Command Status;
+    // its handler already treats an invalid Command Complete as "unsupported".
+    bool is_lying_optional = op_code == OpCode::READ_DEFAULT_ERRONEOUS_DATA_REPORTING &&
+                             status_view.IsValid() &&
+                             status_view.GetStatus() != ErrorCode::SUCCESS;
+    if ((is_status && waiting_for == WaitingFor::COMPLETE) &&
+        ((is_vendor_specific && status_view.IsValid() &&
+          status_view.GetStatus() == ErrorCode::UNKNOWN_HCI_COMMAND) ||
+         is_lying_optional)) {
       // If this is a command status of a vendor specific command, and command complete is expected,
       // we can't treat this as hard failure since we have no way of probing this lack of support at
       // earlier time. Instead we let the command complete handler handle a empty Command Complete
