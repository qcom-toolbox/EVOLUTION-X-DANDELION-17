+//
+// SPDX-FileCopyrightText: The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+//
+// AIDL ILights (backlight only) for dandelion. Android 17's LightsService only
+// talks to AIDL, and this build keeps the stock Android 10 vendor (HIDL light@2.0),
+// so without this the backlight can't be restored after the first screen-off.
+
+cc_binary {
+    name: "android.hardware.light-service.dandelion",
+    system_ext_specific: true,
+    relative_install_path: "hw",
+    init_rc: ["android.hardware.light-service.dandelion.rc"],
+    vintf_fragments: ["android.hardware.light-service.dandelion.xml"],
+    srcs: ["service.cpp"],
+    shared_libs: [
+        "libbase",
+        "libbinder_ndk",
+        "android.hardware.light-V2-ndk",
+    ],
+}
