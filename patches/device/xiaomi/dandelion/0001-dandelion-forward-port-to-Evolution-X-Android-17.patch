+sp<SurfaceControl> shim_createSurface(SurfaceComposerClient* self, const String8& name,
+                                      uint32_t w, uint32_t h, PixelFormat format,
+                                      uint32_t flags, SurfaceControl* parent,
+                                      LayerMetadata metadata) {
