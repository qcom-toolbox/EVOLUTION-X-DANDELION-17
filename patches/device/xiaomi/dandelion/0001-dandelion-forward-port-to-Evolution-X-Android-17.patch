diff --git a/vndk-compat/Android.bp b/vndk-compat/Android.bp
new file mode 100644
index 0000000..6277363
--- /dev/null
+++ b/vndk-compat/Android.bp
@@ -0,0 +1,14 @@
+//
+// SPDX-FileCopyrightText: The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+//
+// The prebuilt Android 10 (VNDK 29) libhidlbase loads VNDK-SP passthrough HALs from
+// /system/lib/vndk-sp-29/hw/ (e.g. android.hidl.memory@1.0-impl.so, the ashmem
+// IMapper). Android 10 provided that path as a symlink into the VNDK APEX; Android 17
+// doesn't, so every vendor process mapping hidl_memory failed (PQ HAL, OMX codecs).
+
+install_symlink {
+    name: "dandelion_vndk_sp_29_symlink",
+    installed_location: "lib/vndk-sp-29",
+    symlink_target: "/apex/com.android.vndk.v29/lib",
+}
