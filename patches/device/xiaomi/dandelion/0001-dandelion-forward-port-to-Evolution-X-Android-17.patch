+
+// Q-era static SurfaceComposerClient::getDisplayInfo(token, DisplayInfo*).
+// The DisplayInfo struct no longer exists, so report failure instead of
+// writing a layout the caller does not expect.
+status_t shim_getDisplayInfo(const sp<IBinder>& display, void* info)
