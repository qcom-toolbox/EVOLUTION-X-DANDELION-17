diff --git a/rootdir/etc/init.dandelion.usb.rc b/rootdir/etc/init.dandelion.usb.rc
new file mode 100644
index 0000000..14e447b
--- /dev/null
+++ b/rootdir/etc/init.dandelion.usb.rc
@@ -0,0 +1,6 @@
+# The stock Android 10 vendor init.mt6765.usb.rc does
+#   setprop sys.usb.config none; setprop sys.usb.config ${sys.usb.state}
+# when persist.vendor.radio.port_index loads. On A17 sys.usb.state is still unset
+# then, so USB ends up "none" (no adb/MTP). Seed it with the build default.
+on post-fs
+    setprop sys.usb.state ${persist.sys.usb.config:-mtp}
